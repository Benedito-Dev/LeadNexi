{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "rewrites": [
        {
          "source": "/privacidade",
          "destination": "/privacidade.html"
        },
        {
          "source": "/exclusao-de-dados",
          "destination": "/exclusao-de-dados.html"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/main.ts",
      "buildCommand": "npm run vercel-build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/instagram-daily",
      "schedule": "0 9 * * *"
    }
  ]
}
