generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Usuário único do sistema (login simples)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// Funil de vendas (Kanban) customizável
model Pipeline {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  stages    Stage[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pipelines")
}

// Coluna do Kanban
model Stage {
  id         String   @id @default(uuid())
  name       String
  color      String?
  position   Int      @default(0)
  pipelineId String   @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads      Lead[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([pipelineId])
  @@map("stages")
}

// Card do Kanban
model Lead {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  email          String?
  source         String?
  estimatedValue Decimal? @map("estimated_value") @db.Decimal(12, 2)
  notes          String?
  position       Int      @default(0)
  stageId        String   @map("stage_id")
  stage          Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// Próximo contato agendado (um por lead); null = nenhum
  followUpAt     DateTime? @map("follow_up_at")
  followUpNote   String?   @map("follow_up_note")
  activities     LeadActivity[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([stageId])
  @@index([followUpAt])
  @@map("leads")
}

enum LeadActivityType {
  CREATED
  STAGE_CHANGED
  NOTE
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_DONE
}

// Histórico do lead: uma linha por acontecimento, da mais nova para a mais antiga
model LeadActivity {
  id        String           @id @default(uuid())
  leadId    String           @map("lead_id")
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  /// Texto da nota, ou descrição do follow-up
  text      String?
  /// Nomes das etapas no momento da mudança (sobrevivem a renomear/apagar a etapa)
  fromStage String?          @map("from_stage")
  toStage   String?          @map("to_stage")
  /// Data do follow-up agendado
  dueAt     DateTime?        @map("due_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("lead_activities")
}
