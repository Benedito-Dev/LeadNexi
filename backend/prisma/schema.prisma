generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Usuário único do sistema (login simples)
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("users")
}

// Funil de vendas (Kanban) customizável
model Pipeline {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  stages    Stage[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pipelines")
}

// Coluna do Kanban
model Stage {
  id         String   @id @default(uuid())
  name       String
  color      String?
  position   Int      @default(0)
  pipelineId String   @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads      Lead[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([pipelineId])
  @@map("stages")
}

// Card do Kanban
model Lead {
  id             String         @id @default(uuid())
  name           String
  phone          String?
  email          String?
  source         String?
  estimatedValue Decimal?       @map("estimated_value") @db.Decimal(12, 2)
  notes          String?
  position       Int            @default(0)
  stageId        String         @map("stage_id")
  stage          Stage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// Próximo contato agendado (um por lead); null = nenhum
  followUpAt     DateTime?      @map("follow_up_at")
  followUpNote   String?        @map("follow_up_note")
  activities     LeadActivity[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([stageId])
  @@index([followUpAt])
  @@map("leads")
}

enum LeadActivityType {
  CREATED
  STAGE_CHANGED
  NOTE
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_DONE
}

// Histórico do lead: uma linha por acontecimento, da mais nova para a mais antiga
model LeadActivity {
  id        String           @id @default(uuid())
  leadId    String           @map("lead_id")
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  /// Texto da nota, ou descrição do follow-up
  text      String?
  /// Nomes das etapas no momento da mudança (sobrevivem a renomear/apagar a etapa)
  fromStage String?          @map("from_stage")
  toStage   String?          @map("to_stage")
  /// Data do follow-up agendado
  dueAt     DateTime?        @map("due_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// Sessões de login: refresh tokens com rotação. Cada login abre uma família; cada renovação cria
// um token novo na mesma família e revoga o anterior. Só o hash (sha256) do segredo é guardado.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Token que substituiu este na rotação
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Conta do Instagram conectada (login oficial da Meta). O token de acesso fica criptografado
// (AES-256-GCM, chave TOKEN_ENCRYPTION_KEY) e dura 60 dias; o cron diário renova antes de vencer.
model InstagramAccount {
  id                String    @id @default(uuid())
  /// ID da conta profissional no Instagram (`user_id`): é o usado para publicar
  igUserId          String    @unique @map("ig_user_id")
  username          String
  name              String?
  profilePictureUrl String?   @map("profile_picture_url")
  /// Token criptografado ("v1.<iv>.<tag>.<dados>"), nunca em texto puro
  accessToken       String    @map("access_token")
  tokenExpiresAt    DateTime  @map("token_expires_at")
  /// Quando a Meta recusou o token (revogado ou vencido): a conta precisa ser reconectada
  tokenInvalidAt    DateTime? @map("token_invalid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("instagram_accounts")
}

// App da Meta usado no login do Instagram, configurado pela tela do Instagram. Uma linha só
// (id = 1); a chave secreta fica criptografada. Sem esta linha, valem as variáveis INSTAGRAM_*.
model InstagramAppSettings {
  id        Int      @id @default(1)
  /// "ID do app do Instagram" (no painel da Meta: API com login do Instagram)
  appId     String   @map("app_id")
  /// "Chave secreta do app do Instagram", criptografada ("v1.<iv>.<tag>.<dados>")
  appSecret String   @map("app_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("instagram_app_settings")
}

enum InstagramPostStatus {
  /// Esperando a hora de publicar
  SCHEDULED
  /// Sendo enviado ao Instagram agora
  PUBLISHING
  PUBLISHED
  FAILED
}

// Post do Instagram montado no LeadNexi: legenda, imagens (em ordem) e quando publicar.
model InstagramPost {
  id                  String              @id @default(uuid())
  caption             String
  /// Quando publicar
  scheduledAt         DateTime            @map("scheduled_at")
  status              InstagramPostStatus @default(SCHEDULED)
  /// Motivo da falha, em português claro, para a tela
  error               String?
  /// Tentativas automáticas de publicar (falha passageira da Meta tenta de novo até o limite)
  attempts            Int                 @default(0)
  /// Quando começou a publicação em andamento (PUBLISHING parado há muito tempo = interrompido)
  publishingStartedAt DateTime?           @map("publishing_started_at")
  publishedAt         DateTime?           @map("published_at")
  /// ID do post no Instagram e o link público dele
  igMediaId           String?             @map("ig_media_id")
  permalink           String?
  images              InstagramMedia[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@map("instagram_posts")
}

// Imagem (JPEG) guardada no armazenamento de arquivos (padrão S3; a chave é o caminho lá).
// Nasce solta, no upload, e é presa a um post ao agendar; solta há mais de 24 h, o cron apaga.
model InstagramMedia {
  id         String         @id @default(uuid())
  postId     String?        @map("post_id")
  post       InstagramPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Ordem no carrossel (0 = capa)
  position   Int            @default(0)
  storageKey String         @unique @map("storage_key")
  width      Int
  height     Int
  sizeBytes  Int            @map("size_bytes")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([postId])
  @@map("instagram_media")
}
