generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Usuário único do sistema (login simples)
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  /// Foto de perfil (JPEG 256x256, ~20 KB): no banco, sem depender do armazenamento de arquivos.
  /// O ID muda a cada foto nova, para o navegador poder guardar em cache para sempre
  avatarId      String?        @unique @map("avatar_id")
  avatar        Bytes?
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("users")
}

// Funil de vendas (Kanban) customizável
model Pipeline {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  stages    Stage[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pipelines")
}

// Coluna do Kanban
model Stage {
  id         String   @id @default(uuid())
  name       String
  color      String?
  stageType  StageType @default(CUSTOM) @map("stage_type")
  position   Int      @default(0)
  pipelineId String   @map("pipeline_id")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads      Lead[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([pipelineId])
  @@map("stages")
}

enum StageType {
  CONTACT
  SENT
  RESPONDED
  MEETING
  PROPOSAL
  WON
  LOST
  CUSTOM
}

model LeadList {
  id             String   @id @default(uuid())
  name           String
  niche          String?
  city           String?
  targetContacts Int?     @map("target_contacts")
  archived       Boolean  @default(false)
  leads          Lead[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([archived, createdAt])
  @@map("lead_lists")
}

// Card do Kanban
model Lead {
  id                     String         @id @default(uuid())
  name                   String
  phone                  String?
  email                  String?
  source                 String?
  estimatedValue         Decimal?       @map("estimated_value") @db.Decimal(12, 2)
  notes                  String?
  position               Int            @default(0)
  listId                 String         @map("list_id")
  list                   LeadList       @relation(fields: [listId], references: [id], onDelete: Restrict)
  archived               Boolean        @default(false)
  phoneType              String?        @map("phone_type")
  neighborhood           String?
  address                String?
  mapsUrl                String?        @map("maps_url")
  googlePlaceId          String?        @map("google_place_id")
  googleRating           Float?         @map("google_rating")
  googleReviewCount      Int?           @map("google_review_count")
  isNetwork              Boolean        @default(false) @map("is_network")
  adStatus               String?        @map("ad_status")
  cadenceStep            Int?           @map("cadence_step")
  meetingAt              DateTime?      @map("meeting_at")
  lostReason             String?        @map("lost_reason")
  wonAt                  DateTime?      @map("won_at")
  stageId                String         @map("stage_id")
  stage                  Stage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// Próximo contato agendado (um por lead); null = nenhum
  followUpAt             DateTime?      @map("follow_up_at")
  followUpNote           String?        @map("follow_up_note")
  /// @ do Instagram (sem o @)
  instagramUsername      String?        @map("instagram_username")
  /// Quem mandou direct (ID da pessoa no Instagram, IGSID): liga as mensagens novas ao lead
  instagramUserId        String?        @unique @map("instagram_user_id")
  /// Foto de perfil guardada no armazenamento (leads/avatars/<id>.jpg); troca de ID a cada foto nova
  avatarId               String?        @map("avatar_id")
  /// Quando a foto foi conferida pela última vez (o LeadNexi atualiza no máximo uma vez por semana)
  avatarUpdatedAt        DateTime?      @map("avatar_updated_at")
  /// Última mensagem que o lead mandou no direct: a janela de 24 h para responder conta daqui
  instagramLastMessageAt DateTime?      @map("instagram_last_message_at")
  /// Nome de quem decide na loja (o "responsável"), quando já se sabe
  responsibleName        String?        @map("responsible_name")
  /// Resumo da conversa gerado pela IA: { situation, wants, nextStep, nextStepDays }
  aiSummary              Json?          @map("ai_summary")
  aiSummaryAt            DateTime?      @map("ai_summary_at")
  activities             LeadActivity[]
  aiSuggestions          AiSuggestion[]
  /// Ficha de cliente, criada quando o lead vai para "Fechou"
  client                 Client?
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  @@index([stageId])
  @@index([listId])
  @@index([archived])
  @@index([followUpAt])
  @@index([meetingAt])
  @@index([wonAt])
  @@map("leads")
}

enum LeadActivityType {
  CREATED
  STAGE_CHANGED
  NOTE
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_DONE
  /// Mensagem recebida no direct do Instagram
  INSTAGRAM_MESSAGE
  /// Mensagem enviada ao lead no direct (pelo app do Instagram ou pelo LeadNexi)
  INSTAGRAM_MESSAGE_SENT
  /// Mensagem enviada manualmente pelo usuário no WhatsApp
  WHATSAPP_MESSAGE_SENT
  /// Resposta do lead registrada manualmente pelo usuário no WhatsApp
  WHATSAPP_MESSAGE_RECEIVED
  /// Dados do lead editados (hoje, só quando vem do Claude: o texto lista os campos)
  LEAD_UPDATED
}

// Histórico do lead: uma linha por acontecimento, da mais nova para a mais antiga
model LeadActivity {
  id         String           @id @default(uuid())
  leadId     String           @map("lead_id")
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       LeadActivityType
  /// Texto da nota, ou descrição do follow-up
  text       String?
  /// Nomes das etapas no momento da mudança (sobrevivem a renomear/apagar a etapa)
  fromStage  String?          @map("from_stage")
  toStage    String?          @map("to_stage")
  /// Data do follow-up agendado
  dueAt      DateTime?        @map("due_at")
  /// Canal do contato, quando houver
  channel    String?
  /// Passo da cadência associado ao contato, quando houver
  cadenceStep Int?            @map("cadence_step")
  /// Identificador do template usado na mensagem
  templateId  String?         @map("template_id")
  /// Variação do template, quando houver
  variation   String?
  /// ID da mensagem na Meta: a mesma mensagem avisada duas vezes entra uma vez só
  externalId String?          @unique @map("external_id")
  /// Quem fez de fora do app: "claude" (servidor MCP). Vazio = feito nas telas ou pelos webhooks
  via        String?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@index([channel])
  @@index([templateId])
  @@map("lead_activities")
}

// Metas da operação de prospecção (singleton: id = 1)
model ProspectingSettings {
  id                 Int      @id @default(1)
  dailyTarget        Int      @default(5) @map("daily_target")
  weeklyTarget       Int      @default(30) @map("weekly_target")
  monthlyRevenueGoal Decimal  @default(300) @map("monthly_revenue_goal") @db.Decimal(12, 2)
  dailyLimit         Int      @default(8) @map("daily_limit")
  decisionContacts   Int      @default(30) @map("decision_contacts")
  decisionMinReplies Int      @default(2) @map("decision_min_replies")
  /// Modelos de mensagem da cadência (vazio = o texto padrão); marcadores {saudacao}, {loja} e {data}
  messageFirst       String?  @map("message_first")
  messageFollowUp    String?  @map("message_follow_up")
  messageLast        String?  @map("message_last")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("prospecting_settings")
}

// Banco de provas: resultados reais (com fonte e data) que a IA pode citar. Nada fora daqui.
model Proof {
  id            String   @id @default(uuid())
  /// Frase pronta para citar, ex.: "Loja de celular em Fortaleza: R$ 2,26 por conversa..."
  text          String
  /// Número em destaque, ex.: "R$ 2,26 por conversa"
  highlight     String?
  /// De onde saiu o número, ex.: "Gerenciador de Anúncios"
  source        String
  /// Período ou data do resultado, ex.: "out/2026"
  referenceDate String?  @map("reference_date")
  /// O cliente autorizou citar o nome da loja?
  canNameClient Boolean  @default(false) @map("can_name_client")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("proofs")
}

enum AiFeature {
  /// Gerar mensagem (1ª mensagem e follow-ups)
  MESSAGE
  /// Sugerir resposta a uma mensagem do lead
  REPLY
  /// Resumir conversa (com próximo passo sugerido)
  SUMMARY
  /// Textos da análise grátis
  ANALYSIS
}

// Cada resposta da IA: o que foi pedido, o que voltou e o que o usuário fez com ela
model AiSuggestion {
  id            String    @id @default(uuid())
  leadId        String    @map("lead_id")
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  feature       AiFeature
  /// Versão do prompt de sistema usado (ex.: "message-v1")
  promptVersion String    @map("prompt_version")
  model         String
  /// Contexto enviado ao modelo (para depurar)
  input         Json
  /// Resposta estruturada do modelo
  output        Json
  /// Opção escolhida pelo usuário (0, 1, 2), quando houver
  chosenIndex   Int?      @map("chosen_index")
  /// 1 = gostou, -1 = não gostou
  feedback      Int?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("ai_suggestions")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ENDED
}

// Cliente ativo (pós-venda, spec F9): nasce quando o lead vai para "Fechou". Um por lead.
model Client {
  id                  String          @id @default(uuid())
  leadId              String          @unique @map("lead_id")
  lead                Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status              ClientStatus    @default(ACTIVE)
  plan                String          @default("Gestão de anúncios no Meta")
  /// Mensalidade do serviço (R$ 500 no 1º mês, pela oferta de entrada)
  monthlyFee          Decimal         @default(500) @map("monthly_fee") @db.Decimal(12, 2)
  startDate           DateTime        @map("start_date")
  /// Dia do mês da cobrança (1 a 28: existe em todo mês)
  billingDay          Int             @map("billing_day")
  /// Verba diária de anúncio combinada (paga pelo cliente direto à Meta)
  dailyAdBudget       Decimal?        @map("daily_ad_budget") @db.Decimal(12, 2)
  /// Checklist de entrada
  partnerAccess       Boolean         @default(false) @map("partner_access")
  whatsappGreeting    Boolean         @default(false) @map("whatsapp_greeting")
  firstCampaignLive   Boolean         @default(false) @map("first_campaign_live")
  notes               String?
  reports             ClientReport[]
  payments            ClientPayment[]
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@map("clients")
}

// Relatório semanal do cliente: gasto e conversas iniciadas no WhatsApp
model ClientReport {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Segunda-feira da semana do relatório
  weekStart     DateTime @map("week_start") @db.Date
  spend         Decimal  @db.Decimal(12, 2)
  conversations Int
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([clientId, weekStart])
  @@map("client_reports")
}

// Pagamento recebido do cliente (Pix)
model ClientPayment {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @map("paid_at")
  /// Mês que o pagamento cobre, ex.: "2026-11"
  period    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, paidAt])
  @@map("client_payments")
}

// Sessões de login: refresh tokens com rotação. Cada login abre uma família; cada renovação cria
// um token novo na mesma família e revoga o anterior. Só o hash (sha256) do segredo é guardado.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Token que substituiu este na rotação
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Conta do Instagram conectada (login oficial da Meta). O token de acesso fica criptografado
// (AES-256-GCM, chave TOKEN_ENCRYPTION_KEY) e dura 60 dias; o cron diário renova antes de vencer.
model InstagramAccount {
  id                String    @id @default(uuid())
  /// ID da conta profissional no Instagram (`user_id`): é o usado para publicar
  igUserId          String    @unique @map("ig_user_id")
  username          String
  name              String?
  profilePictureUrl String?   @map("profile_picture_url")
  /// Token criptografado ("v1.<iv>.<tag>.<dados>"), nunca em texto puro
  accessToken       String    @map("access_token")
  tokenExpiresAt    DateTime  @map("token_expires_at")
  /// Quando a Meta recusou o token (revogado ou vencido): a conta precisa ser reconectada
  tokenInvalidAt    DateTime? @map("token_invalid_at")
  /// Quando os avisos do direct foram ligados para a conta (webhook de mensagens na Meta)
  messagesEnabledAt DateTime? @map("messages_enabled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("instagram_accounts")
}

// App da Meta usado no login do Instagram, configurado pela tela do Instagram. Uma linha só
// (id = 1); a chave secreta fica criptografada. Sem esta linha, valem as variáveis INSTAGRAM_*.
model InstagramAppSettings {
  id        Int      @id @default(1)
  /// "ID do app do Instagram" (no painel da Meta: API com login do Instagram)
  appId     String   @map("app_id")
  /// "Chave secreta do app do Instagram", criptografada ("v1.<iv>.<tag>.<dados>")
  appSecret String   @map("app_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("instagram_app_settings")
}

enum InstagramPostStatus {
  /// Esperando a hora de publicar
  SCHEDULED
  /// Sendo enviado ao Instagram agora
  PUBLISHING
  PUBLISHED
  FAILED
  /// Publicado, mas não está mais no perfil (apagado ou arquivado no Instagram)
  REMOVED
}

// Post do Instagram montado no LeadNexi: legenda, imagens (em ordem) e quando publicar.
model InstagramPost {
  id                  String              @id @default(uuid())
  caption             String
  /// Quando publicar
  scheduledAt         DateTime            @map("scheduled_at")
  status              InstagramPostStatus @default(SCHEDULED)
  /// Motivo da falha, em português claro, para a tela
  error               String?
  /// Tentativas automáticas de publicar (falha passageira da Meta tenta de novo até o limite)
  attempts            Int                 @default(0)
  /// Quando começou a publicação em andamento (PUBLISHING parado há muito tempo = interrompido)
  publishingStartedAt DateTime?           @map("publishing_started_at")
  publishedAt         DateTime?           @map("published_at")
  /// ID do post no Instagram e o link público dele
  igMediaId           String?             @map("ig_media_id")
  permalink           String?
  /// Post publicado usado como exemplo no follow-up ("Te mando um exemplo do que fizemos")
  isProof             Boolean             @default(false) @map("is_proof")
  /// Do que é o exemplo, ex.: "Case da loja de celular"
  proofNote           String?             @map("proof_note")
  images              InstagramMedia[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@index([isProof])
  @@map("instagram_posts")
}

// Grupo de hashtags salvo para inserir na legenda com 1 clique
model InstagramHashtagSet {
  id        String   @id @default(uuid())
  name      String
  /// As hashtags, separadas por espaço: "#celular #fortaleza"
  tags      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("instagram_hashtag_sets")
}

// Imagem (JPEG) guardada no armazenamento de arquivos (padrão S3; a chave é o caminho lá).
// Nasce solta, no upload, e é presa a um post ao agendar; solta há mais de 24 h, o cron apaga.
model InstagramMedia {
  id         String         @id @default(uuid())
  postId     String?        @map("post_id")
  post       InstagramPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Ordem no carrossel (0 = capa)
  position   Int            @default(0)
  storageKey String         @unique @map("storage_key")
  width      Int
  height     Int
  sizeBytes  Int            @map("size_bytes")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([postId])
  @@map("instagram_media")
}

// Senhas de acesso do Claude ao servidor MCP (Configurações › IA e Claude). Só o hash fica no
// banco: o token aparece uma vez, ao ser criado. Revogar corta o acesso na hora.
model McpToken {
  id         String    @id @default(uuid())
  name       String
  tokenHash  String    @unique @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("mcp_tokens")
}
