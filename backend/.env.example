DATABASE_URL="postgresql://leadnexi:leadnexi@localhost:5435/leadnexi?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Access token curto; a sessão longa fica no refresh token (cookie httpOnly)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Usuário criado pelo seed (npx prisma db seed)
SEED_USER_EMAIL=voce@email.com
SEED_USER_NAME=Seu Nome
SEED_USER_PASSWORD=troque-esta-senha

# Instagram (app da Meta: "API com login do Instagram"). O normal é salvar o ID e a chave secreta
# pela tela do Instagram, que vale mais que estas variáveis. Elas ficam só como alternativa.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Endereço de retorno do login. Vazio = montado pelo endereço do site (/api/instagram/callback).
INSTAGRAM_REDIRECT_URI=
# Chave que criptografa o token do Instagram e a chave secreta do app: 32 bytes em base64
# (openssl rand -base64 32). Vazio = derivada do JWT_SECRET. Trocar a chave em uso obriga a
# salvar o app de novo na tela e conectar a conta outra vez.
TOKEN_ENCRYPTION_KEY=

# Segredo das tarefas agendadas (/api/cron/*). A Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Despertador da publicação na hora marcada: QStash, da Upstash (plano gratuito). Copie os quatro
# valores do painel do QStash. Sem eles, os agendados não saem sozinhos (só "Publicar agora").
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Armazenamento das imagens dos posts (qualquer provedor no padrão S3). Sem estes valores, o envio
# de imagens responde 503. Na Telnyx, a chave de API vai nos dois campos de chave.
STORAGE_ENDPOINT=https://us-central-1.telnyxcloudstorage.com
STORAGE_REGION=us-central-1
STORAGE_BUCKET=vitrine
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Só no desenvolvimento, sem as chaves acima: guarda os arquivos nesta pasta (ex.: ./.storage-local)
STORAGE_LOCAL_DIR=

# IA (spec F4): chave da API da Anthropic (Claude), criada em console.anthropic.com. Fica só no
# servidor. Sem ela, os botões de IA avisam que a IA não está configurada.
ANTHROPIC_API_KEY=
# Modelo da Claude. Vazio = claude-opus-5-5.
ANTHROPIC_MODEL=

# WhatsApp não oficial (Evolution API, a ponte que lê o QR code). No Mac: `docker compose --profile
# whatsapp up -d` sobe a ponte em http://localhost:8081 com a chave abaixo. Vazio = canal desligado.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=leadnexi
# Endereço que a ponte chama a cada mensagem. Vazio = montado pelo endereço do site. No Mac, a ponte
# (no Docker) chega ao backend por: http://host.docker.internal:3000/api/whatsapp/webhook
WHATSAPP_WEBHOOK_URL=
