DATABASE_URL="postgresql://leadnexi:leadnexi@localhost:5435/leadnexi?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Access token curto; a sessão longa fica no refresh token (cookie httpOnly)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Usuário criado pelo seed (npx prisma db seed)
SEED_USER_EMAIL=voce@email.com
SEED_USER_NAME=Seu Nome
SEED_USER_PASSWORD=troque-esta-senha

# Instagram (app da Meta: "API com login do Instagram"). Sem estes valores, "Conectar" avisa que falta configurar.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://leadnexi.vercel.app/api/instagram/callback
# Chave que criptografa o token do Instagram no banco: 32 bytes em base64 (openssl rand -base64 32).
# Trocar a chave invalida os tokens guardados (a conta precisa ser conectada de novo).
TOKEN_ENCRYPTION_KEY=

# Segredo das tarefas agendadas (/api/cron/*). A Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
